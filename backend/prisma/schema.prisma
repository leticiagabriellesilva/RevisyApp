generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Card {
  id              Int         @id @default(autoincrement())
  pergunta        String
  resposta        String
  dificuldade     Boolean     @default(false)
  repeticoes      Int         @default(0)
  intervalo       Int         @default(0) // minutos entre revisões
  fatorFacilidade Float       @default(2.5)
  qualidade       Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  lastReview      DateTime?
  nextReview      DateTime    @default(now())
}
